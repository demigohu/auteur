# Root .env for docker compose. The API's own secrets go in api/.env (see api/.env.example).
# Point this domain's A record at the VPS before starting; Caddy fetches the HTTPS certificate.
DOMAIN=auteur.example.com

# Clerk production instance keys (dashboard.clerk.com -> API keys). The publishable key is also how the
# API finds Clerk's signing keys.
CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_SECRET_KEY=sk_live_
# Meta API spend allowed per account, and for the whole server, in USD (0 = no cap).
USER_SPEND_CAP_USD=3
SPEND_CAP_USD=25

# Largest export height in pixels (1080 = Full HD). 2160 allows 4K but is slow on a small server.
MAX_EXPORT_HEIGHT=1080
# Footage per project, all videos together, in seconds.
MAX_FOOTAGE_SECONDS=600
