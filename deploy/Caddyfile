{$DOMAIN} {
	request_body {
		max_size 600MB
	}

	# API under /api (prefix stripped). No compression and immediate flushing, so the agent's
	# Server-Sent Events reach the browser as they happen.
	handle_path /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}

# The same API on its own subdomain (needs its own DNS A record), for direct calls and /docs. The editor
# keeps using {$DOMAIN}/api: same origin, so the session cookie the event stream relies on is always sent.
api.{$DOMAIN} {
	request_body {
		max_size 600MB
	}
	reverse_proxy api:8000 {
		flush_interval -1
	}
}
